    </a>
    <a href="./zeichnung/">
        <Image src={zeichnung} alt="" />
        <span>Zeichnung</span>
    </a>
    <a href="./plastik/">
        <Image src={plastik} alt="" />
        <span>Plastik</span>
    </a>
    <a href="./herbarium/">
        <Image src={herbarium} alt="" />
        <span>Herbarium</span>
    </a>
    <a href="./konzepte/">
        <Image src={konzepte} alt="" />
        <span>Konzepte</span>
    </a>
    <a href="./performance/">
        <Image src={performance} alt="" />
        <span>Performance</span>
    </a>
    <a href="./kollaboration/">
        <Image src={kollaboration} alt="" />
        <span>Kollaboration</span>
