import performance from "../../assets/performance.jpg";
import raum from "../../assets/raum.jpg";
import flaeche from "../../assets/flaeche.jpg";
---

<TopicGrid title="Werke" description="Sammlung an Werken von Jemandem">
    <a href="./zeit/">
