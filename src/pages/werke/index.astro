    </a>
    <a href="./flaeche/">
        <Image src={flaeche} alt="" />
        <span>Fläche</span>
    </a>
    <a href="./raum/">
        <Image src={raum} alt="" />
        <span>Raum</span>
    </a>
    <a href="./konzepte/">
        <Image src={konzepte} alt="" />
        <span>Konzepte</span>
    </a>
    <a href="./performance/">
        <Image src={performance} alt="" />
        <span>Performance</span>
    </a>
    <a href="./kollaboration/">
        <Image src={kollaboration} alt="" />
        <span>Kollaboration</span>
