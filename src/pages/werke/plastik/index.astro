---
import { getCollection } from "astro:content";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../../consts";
import GalleryGrid from "../../../layouts/GalleryGrid.astro";
import GalleryCell from "../../../layouts/GalleryCell.astro";

import image from "../../../assets/plastik.jpg";

const entries = (await getCollection("plastik")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<GalleryGrid
    title="Plastik"
    description="Sammlung an Werken von Jemandem"
    image={image.src}
>
    {entries.map((entry) => <GalleryCell entry={entry} />)}
</GalleryGrid>
