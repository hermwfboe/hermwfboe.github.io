---
import { getCollection } from "astro:content";
import { SITE_DESCRIPTION, SITE_TITLE, SITE_BASE_URL } from "../../../consts";
import GalleryGrid from "../../../layouts/GalleryGrid.astro";
import GalleryCell from "../../../layouts/GalleryCell.astro";

import image from "../../../assets/zeit.jpg";

const entries = (await getCollection("zeit")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<GalleryGrid
    title="Zeit"
    description="Sammlung an Werken von Jemandem"
    image={SITE_BASE_URL + image.src}
>
    {entries.map((entry) => <GalleryCell entry={entry} />)}
</GalleryGrid>
