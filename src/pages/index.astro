---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Navigation from '../components/Navigation.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const images = Object.values((import.meta.glob<{ default: ImageMetadata }>("../assets/diashow/*.{jpg,jpeg,png}")));
const firstImage = images[0];
const otherImages = images.slice(1);
---

<!doctype html>
<html lang="de">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image={(await firstImage()).default.src}/>
        <style>
            main, ul {
                display: flex;
                justify-content: center;
                align-items: center;
                list-style: none;
                padding: 0;
                width: 100%;
                min-height: 100svh;
                position: relative;
                overflow: hidden;
            }

            li {
                opacity: 0;
                visibility: hidden;
                transition: 0.3s opacity;
            }

            li, img {
                display: block;
                position: absolute;
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

            h1 {
                position: absolute;
                font-weight: unset;
                font-size: 100px;
                z-index: 10;
            }

            @media (width <= 600px) {
                h1 {
                    font-size: 50px;
                }
            }
        </style>
        <script>
            const listElements: NodeListOf<HTMLLIElement> = document.querySelectorAll("main li");
            const imageMilliseconds = 3000;
            let previousImage = listElements.length - 1;
            let focusedImage = 0;
            let nextImage = 1 % listElements.length;

            listElements[previousImage].style.visibility = "hidden";
            listElements[previousImage].style.opacity = "0";
            listElements[previousImage].style.zIndex = "1";

            listElements[focusedImage].style.visibility = "visible";
            listElements[focusedImage].style.opacity = "1";
            listElements[focusedImage].style.zIndex = "2";

            setInterval(() => {
                listElements[previousImage].style.visibility = "hidden";
                listElements[previousImage].style.opacity = "0";
                listElements[previousImage].style.zIndex = "1";

                listElements[focusedImage].style.visibility = "visible";
                listElements[focusedImage].style.opacity = "1";
                listElements[focusedImage].style.zIndex = "2";

                listElements[nextImage].style.visibility = "visible";
                listElements[nextImage].style.opacity = "1";
                listElements[nextImage].style.zIndex = "3";

                previousImage = focusedImage;
                focusedImage = nextImage;
                nextImage = (nextImage + 1) % listElements.length;
            }, imageMilliseconds)
        </script>
	</head>
	<body>
        <Navigation />
		<main>
            <h1>Hello World!</h1>
            <ul>
                <li>
                    <Image src={firstImage()} alt="" fetchpriority={"high"} />
                </li>
                {
                    otherImages.map(image => (
                        <li>
                            <Image src={image()} alt="" fetchpriority={"low"} />
                        </li>
                    ))
                }
            </ul>
		</main>
	</body>
</html>
