---
import BaseHead from "../components/BaseHead.astro"
import Navigation from "../components/Navigation.astro"

interface Props { title: string, description: string }
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="de">
    <head>
        <BaseHead title={title} description={description} />

        <style>
            main {
                display: grid;
                grid-template-columns: 1fr 1fr 1fr;
                gap: 16px;
                padding: 16px;
                max-width: 800px;
                margin: auto;
                flex-wrap: wrap;
                justify-content: center;
                min-height: 100%;
            }

            main > :global(a) {
                position: relative;
                /*
                NOTE: theoretically works, but looks kinda awful ...
                flex-grow: 1;
                */
                background-color: #eee;
                aspect-ratio: 1 / 1;
                overflow: hidden;
                display: flex;
                justify-content: center;
                align-items: center;

                &>:global(span) {
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    position: absolute;
                    inset: 0;
                    opacity: 0;
                    user-select: none;
                    transition: opacity 0.2s;
                    color: #fff;
                    background-color: #000a;
                    text-shadow: #000 0 0 10px;
                }

                @media (hover: hover) {
                    &:hover {
                        cursor: pointer;
                    }

                    &:global(:hover)>:global(span) {
                        opacity: 1;
                    }
                }
            }

            main > :global(a) > :global(img) {
                height: 100%;
                width: 100%;
                object-fit: cover;
            }

            @media (width <= 600px) {
                main {
                    grid-template-columns: 1fr 1fr;
                }
            }

            @media (width <= 450px) {
                main {
                    grid-template-columns: 1fr;
                }
            }
        </style>
    </head>
    <body>
        <Navigation />
        <main>
            <slot />
        </main>
    </body>
</html>
