---
import BaseHead from "../components/BaseHead.astro";
import Navigation from "../components/Navigation.astro";

interface Props {
    title: string;
    description: string;
    image?: string;
}
const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="de">
    <head>
        <BaseHead title={title} description={description} image={image} />

        <style>
            main {
                display: block;
                padding: 16px;
                max-width: 800px;
                margin: auto;
                text-align: justify;
            }

            main :global(img) {
                display: block;
                max-width: 100%;
                max-height: 100svh;
                margin: auto;
            }
        </style>
    </head>
    <body>
        <Navigation />
        <main>
            <slot />
        </main>
    </body>
</html>
